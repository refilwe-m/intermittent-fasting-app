# Supabase — find these in your Supabase project under Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI Coach ────────────────────────────────────────────────────────────────
# Provider resolution: if VITE_OLLAMA_URL is set, Ollama is used; otherwise the
# HuggingFace router (chat completions) is used.

# Option A — Local Ollama (great for dev/offline; no third-party call)
#   e.g. http://localhost:11434
VITE_OLLAMA_URL=
VITE_OLLAMA_MODEL=mistral

# Option B — HuggingFace Inference (free tier). A token raises rate limits and
# is effectively required for the hosted router. Create one at
# https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_TOKEN=
VITE_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
